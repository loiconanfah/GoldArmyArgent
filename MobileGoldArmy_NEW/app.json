{
  "expo": {
    "name": "MobileGoldArmy",
    "slug": "MobileGoldArmy",
    "owner": "nanfahwa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goldarmy.mobile"
    },
    "android": {
      "package": "com.goldarmy.mobile"
    },
    "web": {
    },
    "scheme": "goldarmy",
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://goldarmy.app"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
