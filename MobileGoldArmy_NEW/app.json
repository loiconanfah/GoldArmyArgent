{
  "expo": {
    "name": "GOLDARMY",
    "slug": "MobileGoldArmy",
    "owner": "nanfahwa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logosansfond.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logosansfond.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goldarmy.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "GoldArmy a besoin d'accéder à votre galerie pour vous permettre de changer votre photo de profil.",
        "NSCameraUsageDescription": "GoldArmy a besoin d'accéder à votre appareil photo pour vous permettre de prendre une photo de profil.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.goldarmy.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {},
    "scheme": "goldarmy",
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://goldarmy.app"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GoldArmy a besoin d'accéder à votre galerie pour vous permettre de changer votre photo de profil.",
          "cameraPermission": "GoldArmy a besoin d'accéder à votre appareil photo pour vous permettre de prendre une photo de profil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logosansfond.png",
          "color": "#F5D061"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://goldarmy.app"
      },
      "eas": {
        "projectId": "ec27a466-2f85-45ad-920b-185e6dabe0d9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ec27a466-2f85-45ad-920b-185e6dabe0d9"
    }
  }
}
